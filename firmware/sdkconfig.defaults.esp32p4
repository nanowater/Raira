# JC4880P443C_I_W (ESP32-P4 + ESP32-C6, 16 MB flash, 32 MB PSRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Chip revision: the board is a v3.2 (read with esptool chip-id), which IDF's default (rev >= 3.0, minimum 3.1) covers. A v1.x chip would
# need CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y and CONFIG_ESP32P4_REV_MIN_100=y instead; the two ranges exclude each other.

# PSRAM: 32 MB, 200 MHz (the vendor's examples; the boot log must confirm "Found 32MB PSRAM device")
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

# Performance and display stability, as in the vendor's example (lvgl_sw_rotation):
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# The L2 cache the vendor uses (256 KB, 128-byte lines)
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
# Code and read-only data run from PSRAM, so writing to the flash (NVS, settings) does not stop the cache and the DSI refresh (DPI
# underrun, white flashes); the vendor's README names this. Needs the experimental switch.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# The flash on this board is a Boya chip (the boot log asks for it)
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

# Allocations of 4 KB and more go to the PSRAM (the vendor's value; the default 16 KB keeps the internal RAM full of mid-size blocks).
# The ESP-Hosted receive buffers come from the internal DMA RAM (MALLOC_CAP_INTERNAL | MALLOC_CAP_DMA), and its driver asserts when that
# is exhausted ("sdio_push_data_to_queue ... pkt_rxbuff": a reboot while many covers were being fetched).
# 8 instead of the vendor's 4096: only tiny blocks stay internal. The LVGL font caches made thousands of 12-32 byte nodes there that kept filling the internal RAM (it fell from 100 to 73 KB in 2.5 h); with 8 it stays flat at ~258 KB (2 h soak).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8

# Frame rate. LVGL redraws at most every LV_DEF_REFR_PERIOD ms: the default 33 ms caps it at ~30 fps (the vendor's example uses 15).
CONFIG_LV_DEF_REFR_PERIOD=16

# A stuck task is better restarted than left frozen: the task watchdog panics (prints a backtrace, then reboots) instead of only warning.
CONFIG_ESP_TASK_WDT_PANIC=y
# (Frame pointers for a full backtrace would make the bootloader 26 KB: it has to fit in 24 KB. The register dump of the panic has the
# program counter and the return address, which is enough to find where a task is stuck.)

# The LVGL loop's task (app_main) used at most ~4.5 KB of its stack in a long run: 8 KB leaves headroom and frees
# 8 KB of internal RAM.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
