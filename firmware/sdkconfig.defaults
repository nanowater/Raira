# Settings both boards share. What is specific to a chip is in sdkconfig.defaults.esp32s3 / sdkconfig.defaults.esp32p4
# (idf.py reads sdkconfig.defaults, then the file of the target; only when sdkconfig is created).

# C++ exceptions: nlohmann_json can throw
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# Our partition table (OTA slots for the code, a read-only partition for the fonts)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LVGL: what the core uses (the simulator's configs/get_started.defconfig also has demos, SDL, GIF, Lottie, ... that the device does not need)
# 16-bit colour: the panel is RGB565
CONFIG_LV_COLOR_DEPTH_16=y
# LVGL allocates through malloc (CONFIG_SPIRAM_USE_MALLOC sends the big blocks to PSRAM), like the simulator build
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
# the Montserrat sizes the UI code names (14 is on by default); the Noto text fonts come through TinyTTF
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_44=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_TINY_TTF=y
# PNG covers (the fallback when a cover is not a JPEG)
CONFIG_LV_USE_LODEPNG=y
# the hub is a WebSocket server (off by default in esp_http_server)
CONFIG_HTTPD_WS_SUPPORT=y
# esp_http_server (IDF 6) no longer calls the handler for the handshake itself; on_open runs in this callback
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
# app_main builds the settings store, WiFi and the hub (JSON parsing); the 3.5 KB default overflowed on the first boot
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# std::thread uses this stack; the 3 KB default overflowed in the hub start-up thread and corrupted the heap (first-boot test)
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
